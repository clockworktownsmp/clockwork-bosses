{
  "schemaVersion": 1,
  "id": "clockwork_bosses",
  "version": "${version}",
  "name": "Clockwork Bosses",
  "description": "Configurable boss encounters with phase effects, skins, scale and event sounds.",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "custom": {
    "clockwork_bosses:api_revision": 1
  },
  "entrypoints": {
    "main": [
      "clockwork.bosses.ClockworkBosses"
    ],
    "client": [
      "clockwork.bosses.client.ClockworkBossesClient"
    ],
    "server": [
      "clockwork.web.ClockworkBossWorkshop"
    ]
  },
  "mixins": [
    "clockwork_bosses.mixins.json",
    {
      "config": "clockwork_bosses.client.mixins.json",
      "environment": "client"
    }
  ],
  "breaks": {
    "clockwork_bosses_web": "*"
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}",
    "fabric-permission-api-v1": "*"
  }
}
