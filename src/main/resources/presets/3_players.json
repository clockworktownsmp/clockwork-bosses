        "horizontal_range": 15.0,
        "vertical_range": 20.0,
        "requires_line_of_sight": true,
        "knockback_horizontal": 1.3,
        "knockback_vertical": 0.25,
        "charge_time_ticks": 24,
        "recovery_time_ticks": null
      },
      // Phase glow; missing color/transition settings inherit base.
      // color: Glow tint as #RRGGBB.
      "warden_effects": {
        "color": "#FF3344"
      },
      // Active phase aura after emergence. Defaults increase coverage from 1-2 seconds every 10 seconds in
      // phase 1 to continuous coverage in Fury. Timing and duration blend with distance; stronger existing
      // Darkness is respected.
      // enabled: false stops new applications/refreshes; existing Darkness expires normally. null/missing
      // inherits the legacy base or safe default.
      // max_radius: Spherical radius in blocks including height, 0-256; 0 disables. null/missing inherits
      // the legacy base or safe default.
      // edge_interval_ticks: Refresh eligibility at outer edge, 1-12000 ticks; 200 = 10 seconds. Shorter
      // intervals allow more frequent refreshes.
      // center_interval_ticks: Refresh eligibility at boss, 1-12000 ticks; 20 = 1 second. Existing effects
      // refresh when half-duration remains.
      // edge_duration_ticks: Effect length at edge, 1-12000 ticks; 20 = 1 second. Duration below interval
      // creates gaps.
      // center_duration_ticks: Effect length at boss, 1-12000 ticks; 40 = 2 seconds. For continuity use at
      // least twice interval plus scan margin.
      // edge_amplifier: Keep at 0. Priority between overlapping Darkness effects only; does not increase
      // visual darkness or set priority against Night Vision. Edge effect priority, 0-4; 0 = level I. Higher
      // does not make the screen darker. null/missing inherits the legacy base or safe default.
      // center_amplifier: Keep at 0. Priority between overlapping Darkness effects only; does not increase
      // visual darkness or set priority against Night Vision. Center effect priority, 0-4; blended toward
      // edge with distance. 0 = normal. null/missing inherits the legacy base or safe default.
      "darkness": {
        "enabled": true,
        "max_radius": 24.0,
        "edge_interval_ticks": 20,
        "center_interval_ticks": 20,
        "edge_duration_ticks": 120,
        "center_duration_ticks": 120,
        "edge_amplifier": 0,
        "center_amplifier": 0
      },
      // Per-phase target controls; null fields inherit base settings.
      // switch_chance: Probability 0-1 after minimum attacks/time: 0 switches only at the maximum; 1
      // switches at the first eligible completion. Default 0.5. The maximum forces rotation regardless of
      // chance when an alternative exists. null/missing inherits base.
      // mode: Choose nearest, random (default), or farthest alternative. Players must be inside the arena
      // and natively eligible. Melee rotation uses follow range; ranged rotation uses the fired beam
      // horizontal/vertical range. Unset arena uses that attack range. null/missing inherits base.
      // min_target_ticks: Minimum time on one valid target, 0-12000 ticks; default 60 = 3 seconds. Checked
      // on assignments/completed attacks without a timer. Dead, disconnected, removed or ineligible targets
      // can be replaced immediately. Time takes priority over maximum attacks. null/missing inherits base.
      // min_attacks: Completed attacks on the same target before chance rolls, whole number 1-1000; default
      // 1. Counts melee swings (including blocked hits) and fired beams, not cancelled windups. null/missing
      // inherits base.
      // max_attacks: Force rotation after this many completed attacks, whole number 1-1000; default 4. Must
      // be at least min_attacks. Hold time or no alternative can exceed this count; switch at the next
      // eligible completion. Counts reset on an actual target change, not each phase. null/missing inherits
      // base.
      "targeting": {
        "switch_chance": null,
        "mode": null,
        // Show the actual new target to that player and arena viewers. A personal warning can replace a recent
        // audience warning about someone else. Personal warnings still share a recipient cooldown across
        // bosses. Same-target assignments stay silent; skipped titles are not queued. null/missing inherits
        // base.
        // enabled: Enable dramatic target titles. This never postpones attacks or adds recovery time.
        // null/missing inherits base.
        // text: Literal text, at most 80 characters; <player> becomes the actual account name. Default: RUN,
        // <player>!. No JSON formatting or commands. null/missing inherits base.
        // cooldown_ticks: Recipient cooldown, 20-1200 ticks; default 60. Also covers title display/fades. A
        // new target bypasses an audience-only warning; recent personal warnings still throttle across bosses.
        // null/missing inherits base.
        // display_ticks: Hold title 1-100 ticks (default 20), plus 2-tick fade in and 4-tick fade out.
        // null/missing inherits base.
        "announcement": {
          "enabled": null,
          "text": null,
          "cooldown_ticks": null,
          "display_ticks": null
        },
        "min_target_ticks": null,
        "min_attacks": null,
        "max_attacks": null
      },
      // Sound defaults inherited by this phase's roar list; does not trigger a main-phase roar.
      "roar": {
        // Optional mono OGG in this template's sounds folder. Sent through the existing bounded media path and
        // played at the boss. Blank file uses the vanilla roar.
        // file: Lowercase OGG basename, no spaces or paths. Blank uses the native Warden roar; child/phase
        // null inherits the parent sound.
        // volume: Custom roar volume, 0-4; default 1.
        // pitch: Custom roar pitch, 0.5-2; default 1.
        // range: Custom roar hearing/delivery radius, 1-128 blocks; default 32.
        "sound": {
          "file": null,
          "volume": null,
          "pitch": null,
          "range": null
        }
      },
      // Optional 0-16 attack or recovery entries inside this health phase. Empty disables the sequence.
      // Sequential follows file order; random shuffles every entry once per round. Recovery pauses attacks
      // and movement. Main-phase entry/reload resets it; no nested children or health cutoffs.
      "subphases": {
      },
      "subphase_order": "sequential",
      "roar_between_subphases": true,
      // Optional 0-16 roar sounds between subphases. Sequential cycles this list independently: one repeats,
      // two alternate, four pair with four subphases. Random picks one per transition; roars may repeat. No
      // missing-slot inheritance rule is needed.
      "roars": {
      }
    }
  },
  // Boss bar after activation; /boss select arena <template> sets its shared visibility and
  // player-effect area. No selected area means no bar.
  // color: PINK, BLUE, RED, GREEN, YELLOW, PURPLE or WHITE.
  // overlay: PROGRESS, NOTCHED_6, NOTCHED_10, NOTCHED_12 or NOTCHED_20.
  "boss_bar": {
    "color": "PURPLE",
    "overlay": "NOTCHED_20",
    // Infinite buffs only after activation, while inside the boss-bar area. Removed on exit/end;
    // other-source effects take priority. Overlapping areas use highest level. Haste unsupported.
    // enabled: Master switch for individually enabled buffs below.
    "area_effects": {
      "enabled": true,
      // Speed: +20% movement per level.
      // enabled: Enable this buff when the master switch is true.
      // level: Effect level, 1-5 (1 = I); invalid/fractional values use 1.
      "speed": {
        "enabled": false,
        "level": 1
      },
      // Jump Boost: increased jump height.
      // enabled: Enable this buff when the master switch is true.
      // level: Effect level, 1-5 (1 = I); invalid/fractional values use 1.
      "jump_boost": {
        "enabled": false,
        "level": 1
      },
      // Regeneration: healing; higher levels heal more often.
      // enabled: Enable this buff when the master switch is true.
      // level: Effect level, 1-5 (1 = I); invalid/fractional values use 1.
      "regeneration": {
        "enabled": true,
        "level": 1
      },
      // Strength: increased melee damage.
      // enabled: Enable this buff when the master switch is true.
      // level: Effect level, 1-5 (1 = I); invalid/fractional values use 1.
      "strength": {
        "enabled": false,
        "level": 1
      },
      // Resistance: -20% affected damage per level; level V blocks all affected damage. Some damage bypasses
      // it.
      // enabled: Enable this buff when the master switch is true.
      // level: Effect level, 1-5 (1 = I); invalid/fractional values use 1.
      "resistance": {
        "enabled": false,
        "level": 1
      }
    },
    // Who sees the bar and receives configured area effects after activation. Choose a saved box or a 3D
    // radius that follows this Warden. The existing ten-tick watcher checks both; no additional timer.
    // Missing box bounds leave box visibility unset.
    // shape: "box": use saved min/max/dimension; "radius": use radius around the Warden, ignoring min/max.
    // dimension: Dimension ID. Radius mode with an empty value follows the Warden in its current
    // dimension; box mode requires the saved box dimension. A specified dimension restricts either mode.
    // radius: Radius in blocks, 1-256 (default 32); used only for shape "radius". True 3D distance from
    // the Warden position, not a horizontal cylinder.
    "visibility_area": {
      "shape": "box",
      "dimension": "minecraft:overworld",
      // Lower inclusive block corner: x, y, z.
      // x: Block X coordinate, +/-30,000,000.
      // y: Block Y coordinate, +/-30,000,000.
      // z: Block Z coordinate, +/-30,000,000.
      "min": {
        "x": -74,
        "y": 63,
        "z": 98
      },
      // Upper inclusive block corner: x, y, z.
      // x: Block X coordinate, +/-30,000,000.
      // y: Block Y coordinate, +/-30,000,000.
      // z: Block Z coordinate, +/-30,000,000.
      "max": {
        "x": -18,
        "y": 83,
        "z": 157
      },
      "radius": 32.0
    },
    // Active arena participants only. Raises maximum health to a minimum; armor that already grants more
    // stays unchanged. Exit/reentry preserves the current health percentage.
    // enabled: Enable the health minimum independently of beacon effects; default true in new templates.
    // Missing section in older files is disabled.
    // minimum_max_health: Minimum maximum HP, 1-1000; default 100 HP (50 hearts). This is a floor, not
    // extra health added to armor.
    // heal_on_first_entry: Fully heal once per player per encounter, including late arrivals. Reentry,
    // reconnect and reload do not repeat it. Saved on the boss; capped at 4096 participants.
    "player_health": {
      "enabled": true,
      "minimum_max_health": 100.0,
      "heal_on_first_entry": true
    },
    // Give an owner-bound offhand potion during an active encounter. Uses normal drinking time; bottle is
    // reusable. An occupied offhand moves into a free inventory slot; full inventory prevents the gift.
    // enabled: Enable the potion independently of beacon effects and fight health. Default true in new
    // templates; absent section is disabled.
    // heal_hp: HP restored after drinking, 0-1000; default 20 HP (10 hearts). Cannot exceed current max
    // health.
    // cooldown_seconds: Time after a completed drink before another dose, 0.05-600 game seconds; default
    // 15. Shared by all copies and overlapping encounters; survives exit, reconnect and respawn.
    // hunger_restored: Hunger points added, whole number 0-20; default 20. Food level is capped at 20.
    // saturation_restored: Saturation points added, 0-20; default 20. Saturation is capped at the
    // resulting food level.
    "reusable_potion": {
      "enabled": true,
      "heal_hp": 20.0,
      "cooldown_seconds": 15.0,
      "hunger_restored": 20,
      "saturation_restored": 20.0
    }
  },
  // Dormant trigger. Choose an entry box, an emergence-centered entry radius, or redstone. /boss select
  // activation <template> saves a box; optional true also saves the boss-bar box. /boss activate <name>
  // triggers manually. Existing occupants at spawn or after trigger edits must leave/reenter; uses the
  // existing ten-tick watcher.
  // type: "player_enter_area": saved-box entry; "player_enter_radius": radius entry; "redstone": rising
  // signal.
  // dimension: Dimension containing the trigger; empty uses the spawned boss dimension. Malformed
  // dimension IDs disable the trigger.
  // radius: Radius in blocks, 1-256 (default 32), used for type "player_enter_radius". True 3D distance
  // from the saved emergence position; underground depth/scale does not move the trigger. Box min/max
  // and shape are ignored in this mode.
  "activation": {
    "type": "redstone",
    "dimension": "minecraft:overworld",
    // Redstone trigger block: x, y, z.
    // x: Block X coordinate, +/-30,000,000.
    // y: Block Y coordinate, +/-30,000,000.
    // z: Block Z coordinate, +/-30,000,000.
    "position": {
      "x": -54,
      "y": 63,
      "z": 133
    },
    "radius": 32.0
  }
